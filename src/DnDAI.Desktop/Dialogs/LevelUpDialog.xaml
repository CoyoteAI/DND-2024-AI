<Window x:Class="DnDAI.Desktop.Dialogs.LevelUpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Level Up" Height="700" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Level Up!" FontSize="24" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="0,0,0,15"/>

        <!-- Level Info -->
        <Border Grid.Row="1" Background="#ECF0F1" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Current Level" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CurrentLevelText" Text="2" FontSize="32" FontWeight="Bold"
                                   Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="→" FontSize="32" FontWeight="Bold"
                               Foreground="#3498DB" VerticalAlignment="Center" Margin="15,0"/>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="New Level" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NewLevelText" Text="3" FontSize="32" FontWeight="Bold"
                                   Foreground="#27AE60" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ProficiencyBonusText" Text="Proficiency Bonus: +2 → +2"
                           FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Hit Points -->
        <GroupBox Grid.Row="2" Header="Hit Points" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Current Max HP:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="CurrentMaxHPText" Text="20" FontSize="14" Foreground="#7F8C8D" Margin="0,0,0,10"/>

                <TextBlock Text="New Max HP:" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="NewMaxHPTextBox" Text="20" Height="35" Margin="0,0,5,0"/>
                    <Button Grid.Column="1" Content="Roll" Width="70" Height="35" Margin="0,0,5,0"
                            Background="#E67E22" Foreground="White" BorderThickness="0" Click="RollHP_Click"/>
                    <Button Grid.Column="2" Content="Average" Width="70" Height="35"
                            Background="#3498DB" Foreground="White" BorderThickness="0" Click="AverageHP_Click"/>
                </Grid>
                <TextBlock x:Name="HitDieInfoText" Text="Hit Die: d8, CON: +2" FontSize="11"
                           Foreground="#7F8C8D" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- Spell Slots (for spellcasters) -->
        <GroupBox Grid.Row="3" x:Name="SpellSlotsGroupBox" Header="Spell Slots (Optional)" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Update spell slots for your new level:" FontSize="11"
                           Foreground="#7F8C8D" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Level 1-3 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,5">
                        <TextBlock Text="Lvl 1:" FontSize="11"/>
                        <TextBox x:Name="SpellSlots1TextBox" Text="0" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,5,5">
                        <TextBlock Text="Lvl 2:" FontSize="11"/>
                        <TextBox x:Name="SpellSlots2TextBox" Text="0" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="5,0,0,5">
                        <TextBlock Text="Lvl 3:" FontSize="11"/>
                        <TextBox x:Name="SpellSlots3TextBox" Text="0" Height="30"/>
                    </StackPanel>

                    <!-- Level 4-6 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,5,5">
                        <TextBlock Text="Lvl 4:" FontSize="11"/>
                        <TextBox x:Name="SpellSlots4TextBox" Text="0" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,5,5">
                        <TextBlock Text="Lvl 5:" FontSize="11"/>
                        <TextBox x:Name="SpellSlots5TextBox" Text="0" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="5,0,0,5">
                        <TextBlock Text="Lvl 6:" FontSize="11"/>
                        <TextBox x:Name="SpellSlots6TextBox" Text="0" Height="30"/>
                    </StackPanel>

                    <!-- Level 7-9 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Lvl 7:" FontSize="11"/>
                        <TextBox x:Name="SpellSlots7TextBox" Text="0" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="Lvl 8:" FontSize="11"/>
                        <TextBox x:Name="SpellSlots8TextBox" Text="0" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="5,0,0,0">
                        <TextBlock Text="Lvl 9:" FontSize="11"/>
                        <TextBox x:Name="SpellSlots9TextBox" Text="0" Height="30"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Info Text -->
        <TextBlock Grid.Row="5" Text="Remember to choose new features, spells, or abilities for your new level!"
                   FontSize="11" Foreground="#E67E22" FontStyle="Italic" TextWrapping="Wrap"
                   VerticalAlignment="Top" Margin="0,10,0,0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Level Up" Width="100" Height="35" Margin="0,0,10,0"
                    Background="#27AE60" Foreground="White" BorderThickness="0" Click="LevelUp_Click"
                    FontWeight="Bold"/>
            <Button Content="Cancel" Width="100" Height="35"
                    Background="#95A5A6" Foreground="White" BorderThickness="0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
