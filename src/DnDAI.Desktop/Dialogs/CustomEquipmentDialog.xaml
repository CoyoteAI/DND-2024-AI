<Window x:Class="DnDAI.Desktop.Dialogs.CustomEquipmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Custom Equipment" Height="700" Width="650"
        Background="#ECF0F1" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Create Custom Equipment"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,15"/>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Name -->
                    <TextBlock Text="Item Name *" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameTextBox" Height="30" Padding="5" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Equipment Type *" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="TypeComboBox" Height="30" SelectionChanged="TypeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Weapon" Tag="Weapon" IsSelected="True"/>
                                <ComboBoxItem Content="Armor" Tag="Armor"/>
                                <ComboBoxItem Content="Container" Tag="Container"/>
                                <ComboBoxItem Content="Wondrous Item" Tag="Adventuring"/>
                                <ComboBoxItem Content="Tool" Tag="Tool"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Rarity" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="RarityComboBox" Height="30">
                                <ComboBoxItem Content="Common" Tag="Common"/>
                                <ComboBoxItem Content="Uncommon" Tag="Uncommon" IsSelected="True"/>
                                <ComboBoxItem Content="Rare" Tag="Rare"/>
                                <ComboBoxItem Content="Very Rare" Tag="VeryRare"/>
                                <ComboBoxItem Content="Legendary" Tag="Legendary"/>
                                <ComboBoxItem Content="Artifact" Tag="Artifact"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="Description *" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="DescriptionTextBox" Height="80" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5" Margin="0,0,0,15"/>

                    <!-- Magic Item Properties -->
                    <Border Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Magic Item Properties" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <CheckBox x:Name="RequiresAttunementCheckBox" Content="Requires Attunement" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Max Charges" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="MaxChargesTextBox" Height="30" Padding="5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Charge Regeneration" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ChargeRegenTextBox" Height="30" Padding="5" Text="e.g., 1d6+1 at dawn"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cost (gp)" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="CostTextBox" Height="30" Padding="5" Text="0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Weight (lbs)" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="WeightTextBox" Height="30" Padding="5" Text="0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Weapon Properties (conditional) -->
                    <Border x:Name="WeaponPropertiesPanel" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Weapon Properties" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Damage *" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="DamageTextBox" Height="30" Padding="5" Text="1d8"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Damage Type *" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="DamageTypeComboBox" Height="30">
                                        <ComboBoxItem Content="Slashing" IsSelected="True"/>
                                        <ComboBoxItem Content="Piercing"/>
                                        <ComboBoxItem Content="Bludgeoning"/>
                                        <ComboBoxItem Content="Fire"/>
                                        <ComboBoxItem Content="Cold"/>
                                        <ComboBoxItem Content="Lightning"/>
                                        <ComboBoxItem Content="Thunder"/>
                                        <ComboBoxItem Content="Acid"/>
                                        <ComboBoxItem Content="Poison"/>
                                        <ComboBoxItem Content="Force"/>
                                        <ComboBoxItem Content="Necrotic"/>
                                        <ComboBoxItem Content="Radiant"/>
                                        <ComboBoxItem Content="Psychic"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Category" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="WeaponCategoryComboBox" Height="30">
                                        <ComboBoxItem Content="Simple Melee" Tag="SimpleMelee" IsSelected="True"/>
                                        <ComboBoxItem Content="Simple Ranged" Tag="SimpleRanged"/>
                                        <ComboBoxItem Content="Martial Melee" Tag="MartialMelee"/>
                                        <ComboBoxItem Content="Martial Ranged" Tag="MartialRanged"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Range (optional)" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="RangeTextBox" Height="30" Padding="5" Text="e.g., 80/320"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="FinesseCheckBox" Content="Finesse" Margin="0,0,15,0"/>
                                <CheckBox x:Name="VersatileCheckBox" Content="Versatile" Checked="VersatileCheckBox_Checked" Unchecked="VersatileCheckBox_Unchecked" Margin="0,0,15,0"/>
                            </StackPanel>

                            <TextBox x:Name="VersatileDamageTextBox" Height="30" Padding="5" Margin="0,10,0,0"
                                     Visibility="Collapsed" Text="1d10"/>
                        </StackPanel>
                    </Border>

                    <!-- Armor Properties (conditional) -->
                    <Border x:Name="ArmorPropertiesPanel" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Armor Properties" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Armor Class *" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ArmorClassTextBox" Height="30" Padding="5" Text="15"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Category" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="ArmorCategoryComboBox" Height="30">
                                        <ComboBoxItem Content="Light Armor" Tag="Light" IsSelected="True"/>
                                        <ComboBoxItem Content="Medium Armor" Tag="Medium"/>
                                        <ComboBoxItem Content="Heavy Armor" Tag="Heavy"/>
                                        <ComboBoxItem Content="Shield" Tag="Shield"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="StealthDisadvantageCheckBox" Content="Stealth Disadvantage" Margin="0,0,0,5"/>
                        </StackPanel>
                    </Border>

                    <!-- Container Properties (conditional) -->
                    <Border x:Name="ContainerPropertiesPanel" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Container Properties" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Weight Capacity (lbs)" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="WeightCapacityTextBox" Height="30" Padding="5" Text="30"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Volume Capacity (cu ft)" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="VolumeCapacityTextBox" Height="30" Padding="5" Text="1"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Cancel" Width="100" Height="35" Margin="0,0,10,0"
                        Background="#95A5A6" Foreground="White" BorderThickness="0"
                        Click="Cancel_Click" Cursor="Hand"/>
                <Button Content="Create Item" Width="120" Height="35"
                        Background="#27AE60" Foreground="White" BorderThickness="0"
                        Click="Save_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
