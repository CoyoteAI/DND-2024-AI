<Window x:Class="DnDAI.Desktop.Dialogs.CustomWeaponDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Custom Weapon" Height="650" Width="550"
        Background="#ECF0F1" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Create Custom Weapon"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,15"/>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Weapon Name -->
                    <TextBlock Text="Weapon Name *" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameTextBox" Margin="0,0,0,15" Height="30" Padding="5"
                             ToolTip="e.g., 'Flamebrand' or 'Longsword +2'"/>

                    <!-- Base Weapon Type -->
                    <TextBlock Text="Base Weapon Type" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="BaseWeaponComboBox" Height="30" Margin="0,0,0,15"
                              SelectionChanged="BaseWeaponComboBox_SelectionChanged">
                        <ComboBoxItem Content="(None - Custom)" IsSelected="True"/>
                        <ComboBoxItem Content="Longsword"/>
                        <ComboBoxItem Content="Shortsword"/>
                        <ComboBoxItem Content="Greatsword"/>
                        <ComboBoxItem Content="Rapier"/>
                        <ComboBoxItem Content="Dagger"/>
                        <ComboBoxItem Content="Battleaxe"/>
                        <ComboBoxItem Content="Greataxe"/>
                        <ComboBoxItem Content="Warhammer"/>
                        <ComboBoxItem Content="Spear"/>
                        <ComboBoxItem Content="Quarterstaff"/>
                        <ComboBoxItem Content="Mace"/>
                        <ComboBoxItem Content="Shortbow"/>
                        <ComboBoxItem Content="Longbow"/>
                        <ComboBoxItem Content="Light Crossbow"/>
                        <ComboBoxItem Content="Heavy Crossbow"/>
                    </ComboBox>

                    <!-- Magic Bonus -->
                    <TextBlock Text="Magic Bonus" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox x:Name="MagicBonusTextBox" Width="60" Height="30" Padding="5" Text="0"/>
                        <TextBlock Text="(+0 to +3)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#7F8C8D"/>
                    </StackPanel>

                    <!-- Damage Dice -->
                    <TextBlock Text="Damage Dice" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox x:Name="DamageDiceTextBox" Width="100" Height="30" Padding="5" Text="1d8"/>
                        <TextBlock Text="(e.g., 1d8, 2d6)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#7F8C8D"/>
                    </StackPanel>

                    <!-- Versatile -->
                    <CheckBox x:Name="VersatileCheckBox" Content="Versatile (can be used two-handed)"
                              Margin="0,0,0,10" Checked="VersatileCheckBox_Checked" Unchecked="VersatileCheckBox_Unchecked"/>
                    <StackPanel x:Name="VersatilePanel" Visibility="Collapsed" Orientation="Horizontal" Margin="20,0,0,15">
                        <TextBlock Text="Two-Handed Damage:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="VersatileDamageTextBox" Width="100" Height="30" Padding="5" Text="1d10"/>
                    </StackPanel>

                    <!-- Finesse -->
                    <CheckBox x:Name="FinesseCheckBox" Content="Finesse (can use DEX instead of STR)"
                              Margin="0,0,0,15"/>

                    <!-- Special Abilities -->
                    <TextBlock Text="Special Abilities" FontWeight="Bold" Margin="0,10,0,5"/>
                    <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1"
                            CornerRadius="4" Padding="10" Margin="0,0,0,10" MinHeight="100">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                            <StackPanel x:Name="AbilitiesPanel">
                                <TextBlock Text="No special abilities added yet"
                                          Foreground="#7F8C8D" FontStyle="Italic"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Button Content="+ Add Special Ability" Click="AddAbility_Click"
                            Height="30" Background="#3498DB" Foreground="White" BorderThickness="0"/>

                    <!-- Notes -->
                    <TextBlock Text="Notes" FontWeight="Bold" Margin="0,15,0,5"/>
                    <TextBox x:Name="NotesTextBox" Height="60" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Cancel" Width="100" Height="35" Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="Save Weapon" Width="120" Height="35"
                        Background="#27AE60" Foreground="White" BorderThickness="0"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
