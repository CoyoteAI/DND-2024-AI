<Window x:Class="DnDAI.Desktop.Dialogs.AbilityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Special Ability" Height="450" Width="450"
        Background="#ECF0F1" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Add Special Ability"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,15"/>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <!-- Ability Name -->
                <TextBlock Text="Ability Name *" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="AbilityNameTextBox" Margin="0,0,0,15" Height="30" Padding="5"
                         ToolTip="e.g., 'Green Flame Blade', 'Flaming Weapon'"/>

                <!-- Description -->
                <TextBlock Text="Description" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="DescriptionTextBox" Height="60" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5" Margin="0,0,0,15"/>

                <!-- Dice Roll (Optional) -->
                <TextBlock Text="Dice Roll (if applicable)" FontWeight="Bold" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBox x:Name="DiceRollTextBox" Width="100" Height="30" Padding="5"
                             ToolTip="e.g., 1d8, 2d6"/>
                    <TextBlock Text="(optional)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#7F8C8D"/>
                </StackPanel>

                <!-- Damage Type -->
                <TextBlock Text="Damage Type" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="DamageTypeComboBox" Height="30" Margin="0,0,0,15">
                    <ComboBoxItem Content="(None)" IsSelected="True"/>
                    <ComboBoxItem Content="fire"/>
                    <ComboBoxItem Content="cold"/>
                    <ComboBoxItem Content="lightning"/>
                    <ComboBoxItem Content="thunder"/>
                    <ComboBoxItem Content="acid"/>
                    <ComboBoxItem Content="poison"/>
                    <ComboBoxItem Content="psychic"/>
                    <ComboBoxItem Content="necrotic"/>
                    <ComboBoxItem Content="radiant"/>
                    <ComboBoxItem Content="force"/>
                </ComboBox>

                <!-- Usage Limit -->
                <TextBlock Text="Usage Limit" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="UsageLimitComboBox" Height="30" Margin="0,0,0,15">
                    <ComboBoxItem Content="at will" IsSelected="True"/>
                    <ComboBoxItem Content="1/day"/>
                    <ComboBoxItem Content="2/day"/>
                    <ComboBoxItem Content="3/day"/>
                    <ComboBoxItem Content="1/short rest"/>
                    <ComboBoxItem Content="1/long rest"/>
                </ComboBox>

                <!-- Action Type -->
                <TextBlock Text="Action Type" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="ActionTypeComboBox" Height="30">
                    <ComboBoxItem Content="action" IsSelected="True"/>
                    <ComboBoxItem Content="bonus action"/>
                    <ComboBoxItem Content="reaction"/>
                    <ComboBoxItem Content="no action"/>
                </ComboBox>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Cancel" Width="100" Height="35" Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="Add Ability" Width="120" Height="35"
                        Background="#27AE60" Foreground="White" BorderThickness="0"
                        Click="Add_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
