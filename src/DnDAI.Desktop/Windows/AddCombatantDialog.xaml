<Window x:Class="DnDAI.Desktop.Windows.AddCombatantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Combatant" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add Combatant to Combat"
                  FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" Margin="0,0,0,20">
            <TabItem Header="Player Characters">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Select Player Character:" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" x:Name="PCListBox" DisplayMemberPath="Name"/>
                </Grid>
            </TabItem>

            <TabItem Header="NPCs">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Select NPC:" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" x:Name="NPCListBox" DisplayMemberPath="Name"/>
                </Grid>
            </TabItem>

            <TabItem Header="Custom Monster">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Monster Name:" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="0" x:Name="MonsterNameTextBox" Margin="0,25,0,10"/>

                    <TextBlock Grid.Row="1" Text="Hit Points:" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="1" x:Name="MonsterHPTextBox" Margin="0,25,0,10"/>

                    <TextBlock Grid.Row="2" Text="Armor Class:" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="2" x:Name="MonsterACTextBox" Margin="0,25,0,10"/>

                    <TextBlock Grid.Row="3" Text="Initiative Modifier:" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="3" x:Name="MonsterInitTextBox" Margin="0,25,0,0" Text="0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add" Width="100" Margin="0,0,10,0" Click="Add_Click"/>
            <Button Content="Cancel" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
