<Application x:Class="DnDAI.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- You can add custom styles here later -->
            </ResourceDictionary.MergedDictionaries>

            <!-- Colors -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#2C3E50"/>
            <SolidColorBrush x:Key="SecondaryBrush" Color="#34495E"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#3498DB"/>
            <SolidColorBrush x:Key="BackgroundBrush" Color="#ECF0F1"/>
            <SolidColorBrush x:Key="TextBrush" Color="#2C3E50"/>
            <SolidColorBrush x:Key="DMMessageBrush" Color="#E8F5E9"/>
            <SolidColorBrush x:Key="PlayerMessageBrush" Color="#E3F2FD"/>

            <!-- Button Style -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="15,8"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2980B9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- TextBox Style -->
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="8"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderBrush" Value="#BDC3C7"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
